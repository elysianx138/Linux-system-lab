# ============================================
# Linux-system-lab .gitignore
# ============================================

# ---- C/C++ 编译产物 ----
*.o
*.obj
*.exe
*.out
*.a
*.lib
*.so
*.dll
*.dylib
a.out
a.exe

# ---- 编译中间目录 ----
build/
debug/
release/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
**/Makefile

# ---- VS Code 配置（你的编辑器，但别提交） ----
.vscode/
*.code-workspace

# ---- IDE ----
.idea/
*.iml
.project
.classpath
.settings/

# ---- Windows 系统文件 ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- macOS 系统文件 ----
.DS_Store
.DS_Store?

# ---- Linux 系统文件 ----
*.swp
*.swo
*~

# ---- 日志和临时文件 ----
*.log
*.tmp
*.temp

# ---- Python（如果以后学 Python 对比用） ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ---- 你本地的私密笔记（不想公开的内容） ----
private/
_secret*
